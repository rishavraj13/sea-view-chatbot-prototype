MODEL_MODE=mock
MODEL_PROVIDER=groq
MODEL_ID=qwen/qwen3.8-27b
# Set MODEL_MODE=live and GROQ_API_KEY in .env.local for the selected provider.
# A missing selected key yields explicitly labelled mock; provider errors never fall back.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_THINKING_BUDGET=0
GOOGLE_THINKING_LEVEL=low
REASONING_EFFORT=none
# GOOGLE_MODEL remains a legacy fallback only when MODEL_ID is absent and provider=google.
